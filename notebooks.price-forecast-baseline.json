026-07-01T13:19:29.288134Z","iopub.status.idle":"2026-07-01T13:19:31.475755Z","shell.execute_reply":"2026-07-01T13:19:31.475258Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import lightgbm as lgb\nimport matplotlib.pyplot as plt\nimport numpy as np\nimport pandas as pd\nimport seaborn as sns\nfrom sklearn.linear_model import Ridge\nfrom sklearn.metrics import mean_absolute_error\nfrom sklearn.pipeline import Pipeline\nfrom sklearn.preprocessing import StandardScaler\n\nfrom vpp.paths import ProjPaths\n\npaths = ProjPaths()\npaths.ensure_directories()\n\nplt.rcParams[\"figure.dpi\"] = 100\nsns.set_theme(style=\"whitegrid\")\n\nSPLIT_DATE = \"2023-01-01\"","key":"RIwfMzS4Av"},{"type":"outputs","id":"4Nljn2I-kHuQ42fgSfejq","children":[],"key":"HfgiloHfbV"}],"key":"f7K6WKG6tU"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"2. Load Data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZqehCQoAWs"}],"identifier":"id-2-load-data","label":"2. Load Data","html_id":"id-2-load-data","implicit":true,"key":"VxTB9vxR8d"}],"key":"Gu9udgEYpq"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-01T13:19:31.478256Z","iopub.status.busy":"2026-07-01T13:19:31.477914Z","iopub.status.idle":"2026-07-01T13:19:31.523830Z","shell.execute_reply":"2026-07-01T13:19:31.523024Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"prices_raw = pd.read_parquet(paths.smard_prices_file)\nprices_eur_mwh = prices_raw[\"price_de_lu\"].dropna().sort_index()\nprices_berlin = prices_eur_mwh.copy()\nprices_berlin.index = prices_berlin.index.tz_convert(\"Europe/Berlin\")\n\nprint(\n    f\"Loaded {len(prices_berlin):,} hourly prices: \"\n    f\"{prices_berlin.index[0].date()} → {prices_berlin.index[-1].date()}\"\n)","key":"HKm5YBv4Ob"},{"type":"outputs","id":"6JffDvWYWYhejshArYuAR","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Loaded 67,896 hourly prices: 2018-10-01 → 2026-06-29\n"},"children":[],"key":"zyYAKE1V7l"}],"key":"EDwnx56C59"}],"key":"jZyekUMMLo"},{"type":"block","kind":"notebook-content","data":{"lines_to_next_cell":2},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3. Feature Engineering","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"F9bTHpewW1"}],"identifier":"id-3-feature-engineering","label":"3. Feature Engineering","html_id":"id-3-feature-engineering","implicit":true,"key":"oZHoja4wqY"}],"key":"FkinFSL9LO"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-01T13:19:31.525244Z","iopub.status.busy":"2026-07-01T13:19:31.525100Z","iopub.status.idle":"2026-07-01T13:19:31.573028Z","shell.execute_reply":"2026-07-01T13:19:31.572520Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"def build_features(prices: pd.Series) -> pd.DataFrame:\n    \"\"\"Build feature matrix from hourly day-ahead prices.\"\"\"\n    df = prices.to_frame(\"price\")\n\n    # Lag features (row-based; off by ≤1h on DST days — acceptable for baseline)\n    df[\"lag_24\"] = prices.shift(24)\n    df[\"lag_48\"] = prices.shift(48)\n    df[\"lag_168\"] = prices.shift(168)\n\n    # Daily aggregate features (previous day)\n    daily = prices.resample(\"D\").agg(day_mean=\"mean\", day_std=\"std\")\n    daily[\"prev_day_mean\"] = daily[\"day_mean\"].shift(1)\n    daily[\"prev_day_std\"] = daily[\"day_std\"].shift(1)\n    daily[\"week_mean\"] = daily[\"day_mean\"].shift(1).rolling(7).mean()\n\n    # Map daily stats back to hourly via floor(\"D\") join\n    df[\"_day\"] = prices.index.floor(\"D\")\n    df = df.join(\n        daily[[\"prev_day_mean\", \"prev_day_std\", \"week_mean\"]],\n        on=\"_day\",\n    ).drop(columns=\"_day\")\n\n    # Cyclical calendar features\n    idx = prices.index\n    df[\"hour_sin\"] = np.sin(2 * np.pi * idx.hour / 24)\n    df[\"hour_cos\"] = np.cos(2 * np.pi * idx.hour / 24)\n    df[\"dow_sin\"] = np.sin(2 * np.pi * idx.dayofweek / 7)\n    df[\"dow_cos\"] = np.cos(2 * np.pi * idx.dayofweek / 7)\n    df[\"month_sin\"] = np.sin(2 * np.pi * (idx.month - 1) / 12)\n    df[\"month_cos\"] = np.cos(2 * np.pi * (idx.month - 1) / 12)\n\n    return df.dropna()\n\n\nfeatures_df = build_features(prices_berlin)\nFEATURE_COLS = [c for c in features_df.columns if c != \"price\"]\n\nprint(f\"Features ({len(FEATURE_COLS)}): {FEATURE_COLS}\")","key":"w8dC5aPmGs"},{"type":"outputs","id":"4tvDrM5xvvAfVKGZcJKNj","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Features (12): ['lag_24', 'lag_48', 'lag_168', 'prev_day_mean', 'prev_day_std', 'week_mean', 'hour_sin', 'hour_cos', 'dow_sin', 'dow_cos', 'month_sin', 'month_cos']\n"},"children":[],"key":"cyS5ctiP9q"}],"key":"YgqklCLcEp"}],"key":"vw3m31YQu0"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"4. Train / Test Split","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KxhVEXV8VL"}],"identifier":"id-4-train-test-split","label":"4. Train / Test Split","html_id":"id-4-train-test-split","implicit":true,"key":"OpKeCYYCFn"}],"key":"VPibgcPkS0"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-01T13:19:31.574247Z","iopub.status.busy":"2026-07-01T13:19:31.574140Z","iopub.status.idle":"2026-07-01T13:19:31.589960Z","shell.execute_reply":"2026-07-01T13:19:31.589294Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"split_ts = pd.Timestamp(SPLIT_DATE, tz=\"Europe/Berlin\")\ntrain = features_df[features_df.index < split_ts]\ntest = features_df[features_df.index >= split_ts].copy()\n\nX_train = train[FEATURE_COLS].values\ny_train = train[\"price\"].values\nX_test = test[FEATURE_COLS].values\ny_test = test[\"price\"].values\n\nprint(\n    f\"Train: {len(train):,} hours\"\n    f\"  ({train.index[0].date()} → {train.index[-1].date()})\"\n    f\"  mean={y_train.mean():.1f} EUR/MWh\"\n)\nprint(\n    f\"Test:  {len(test):,} hours\"\n    f\"  ({test.index[0].date()} → {test.index[-1].date()})\"\n    f\"  mean={y_test.mean():.1f} EUR/MWh\"\n)\nprint(\"Note: training includes the 2022 energy crisis; test is post-crisis.\")","key":"XgeyYHjouY"},{"type":"outputs","id":"NFaz5_9RWaIK2QaklflCB","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Train: 37,105 hours  (2018-10-08 → 2022-12-31)  mean=97.5 EUR/MWh\nTest:  30,623 hours  (2023-01-01 → 2026-06-29)  mean=89.1 EUR/MWh\nNote: training includes the 2022 energy crisis; test is post-crisis.\n"},"children":[],"key":"f2xhB22Iob"}],"key":"G5u2m0i7gj"}],"key":"B2yG1Ef8NM"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"5. Fit Models","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MVpPNYjmsi"}],"identifier":"id-5-fit-models","label":"5. Fit Models","html_id":"id-5-fit-models","implicit":true,"key":"zisRFAAfSU"}],"key":"yWqvGfuDX3"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-01T13:19:31.591089Z","iopub.status.busy":"2026-07-01T13:19:31.590993Z","iopub.status.idle":"2026-07-01T13:19:33.372949Z","shell.execute_reply":"2026-07-01T13:19:33.372354Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# Naïve: lag-24 extracted directly from test features (no fitting needed)\nlag24_idx = FEATURE_COLS.index(\"lag_24\")\ny_naive = X_test[:, lag24_idx]\n\n# Ridge regression (features scaled)\nridge_pipe = Pipeline(\n    [\n        (\"scaler\", StandardScaler()),\n        (\"ridge\", Ridge(alpha=1.0)),\n    ]\n)\nridge_pipe.fit(X_train, y_train)\ny_ridge = ridge_pipe.predict(X_test)\n\n# LightGBM\nlgb_model = lgb.LGBMRegressor(\n    n_estimators=500,\n    learning_rate=0.05,\n    num_leaves=63,\n    min_child_samples=50,\n    subsample=0.8,\n    colsample_bytree=0.8,\n    n_jobs=1,\n    random_state=42,\n    verbose=-1,\n)\nlgb_model.fit(X_train, y_train)\ny_lgbm = lgb_model.predict(X_test)\n\nprint(\"Training complete.\")","key":"e88nWupp5M"},{"type":"outputs","id":"kvF3xc0Pkbm0sfkNpubrP","children":[{"type":"output","jupyter_data":{"name":"stderr","output_type":"stream","text":"/home/chris/research/vpp-learning/.venv/lib/python3.12/site-packages/sklearn/utils/validation.py:2827: UserWarning: X does not have valid feature names, but LGBMRegressor was fitted with feature names\n  warnings.warn(\n"},"children":[],"key":"WQ8LWAkzZx"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Training complete.\n"},"children":[],"key":"Rv3nTPpNiZ"}],"key":"LlBRlRVADG"}],"key":"XuO1nO5duk"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"6. Metrics","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BSz4Q6Fvat"}],"identifier":"id-6-metrics","label":"6. Metrics","html_id":"id-6-metrics","implicit":true,"key":"Rbaihfm9Kk"}],"key":"WIH05wJeDM"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-01T13:19:33.374420Z","iopub.status.busy":"2026-07-01T13:19:33.374296Z","iopub.status.idle":"2026-07-01T13:19:33.396527Z","shell.execute_reply":"2026-07-01T13:19:33.395876Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"mae_naive = mean_absolute_error(y_test, y_naive)\nmae_ridge = mean_absolute_error(y_test, y_ridge)\nmae_lgbm = mean_absolute_error(y_test, y_lgbm)\n\nridge_pct = (mae_ridge / mae_naive - 1) * 100\nlgbm_pct = (mae_lgbm / mae_naive - 1) * 100\n\nprint(f\"Overall MAE — test {SPLIT_DATE} → {test.index[-1].date()}:\")\nprint(f\"  Naïve (lag-24):  {mae_naive:.2f} EUR/MWh\")\nprint(f\"  Ridge:           {mae_ridge:.2f} EUR/MWh  ({ridge_pct:+.1f}% vs naïve)\")\nprint(f\"  LightGBM:        {mae_lgbm:.2f} EUR/MWh  ({lgbm_pct:+.1f}% vs naïve)\")\n\n# Per-hour MAE\ntest_hours = test.index.hour.values\n\n\ndef _per_hour_mae(\n    y_true: np.ndarray, y_pred: np.ndarray, hours: np.ndarray\n) -> list[float]:\n    return [\n        mean_absolute_error(y_true[hours == h], y_pred[hours == h]) for h in range(24)\n    ]\n\n\nmae_by_hour = pd.DataFrame(\n    {\n        \"naive\": _per_hour_mae(y_test, y_naive, test_hours),\n        \"ridge\": _per_hour_mae(y_test, y_ridge, test_hours),\n        \"lgbm\": _per_hour_mae(y_test, y_lgbm, test_hours),\n    },\n    index=pd.Index(range(24), name=\"hour\"),\n)","key":"b80KXs3cqV"},{"type":"outputs","id":"rNZyFM4deHoB6dbjmljkH","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Overall MAE — test 2023-01-01 → 2026-06-29:\n  Naïve (lag-24):  27.41 EUR/MWh\n  Ridge:           26.72 EUR/MWh  (-2.5% vs naïve)\n  LightGBM:        28.49 EUR/MWh  (+4.0% vs naïve)\n"},"children":[],"key":"A9pxxQV9bY"}],"key":"VWoi3TSnFF"}],"key":"wBAO8y7ONt"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-01T13:19:33.397703Z","iopub.status.busy":"2026-07-01T13:19:33.397616Z","iopub.status.idle":"2026-07-01T13:19:33.686237Z","shell.execute_reply":"2026-07-01T13:19:33.685488Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"fig, axes = plt.subplots(1, 2, figsize=(14, 4.5))\n\nax = axes[0]\nax.plot(\n    mae_by_hour.index,\n    mae_by_hour[\"naive\"],\n    label=\"Naïve (lag-24)\",\n    color=\"gray\",\n    linewidth=1.5,\n    linestyle=\"--\",\n)\nax.plot(\n    mae_by_hour.index,\n    mae_by_hour[\"ridge\"],\n    label=\"Ridge\",\n    color=\"#1f77b4\",\n    linewidth=1.5,\n)\nax.plot(\n    mae_by_hour.index,\n    mae_by_hour[\"lgbm\"],\n    label=\"LightGBM\",\n    color=\"#d62728\",\n    linewidth=1.5,\n)\nax.set_xlabel(\"Hour of day\")\nax.set_ylabel(\"MAE (EUR/MWh)\")\nax.set_title(\"Forecast error by hour (test set)\")\nax.set_xticks(range(0, 24, 2))\nax.legend()\n\nax = axes[1]\nmodel_names = [\"Naïve\", \"Ridge\", \"LightGBM\"]\nmodel_maes = [mae_naive, mae_ridge, mae_lgbm]\nmodel_colors = [\"gray\", \"#1f77b4\", \"#d62728\"]\nbars = ax.bar(model_names, model_maes, color=model_colors, width=0.5)\nfor bar, mae in zip(bars, model_maes):\n    ax.text(\n        bar.get_x() + bar.get_width() / 2,\n        bar.get_height() + 0.2,\n        f\"{mae:.1f}\",\n        ha=\"center\",\n        va=\"bottom\",\n        fontsize=11,\n    )\nax.set_ylabel(\"MAE (EUR/MWh)\")\nax.set_title(f\"Overall MAE (test {SPLIT_DATE[:4]}–{test.index[-1].year})\")\n\nfig.suptitle(\"Day-ahead price forecast accuracy — baseline models\", fontsize=12)\nfig.tight_layout()\nfig.savefig(paths.images_path / \"05_per_hour_mae.png\", dpi=150, bbox_inches=\"tight\")\nplt.show()","key":"z5QmNQeW1B"},{"type":"outputs","id":"diwpzkzqWuWZHcup9nMDD","children":[{"type":"output","jupyter_data":{"name":"stderr","output_type":"stream","text":"/tmp/ipykernel_1416989/2792701697.py:52: UserWarning: FigureCanvasAgg is non-interactive, and thus cannot be shown\n  plt.show()\n"},"children":[],"key":"kPjaaEwW1w"}],"key":"FmG0He2otG"}],"key":"ZXkPIDhshB"},{"type":"block","kind":"notebook-content","children":[{"type":"container","kind":"figure","children":[{"type":"image","url":"/vpp-learning/build/05_per_hour_mae-c89ea743163a17c277b24855ce2308b2.png","alt":"Per-hour MAE by model (left) and overall MAE comparison (right) on the\n2023–2026 test set. The naïve lag-24 baseline is a strong starting point\ndue to pronounced diurnal and weekly seasonality in day-ahead prices.","data":{"altTextIsAutoGe